rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Existing RR7024 daily dashboard records.
    match /stores/RR7024/daily/{dayId} {
      allow read, write: if true;
    }

    // One shared, active weekly schedule for the RR7024 dashboard.
    match /stores/RR7024/weeklySchedule/{scheduleId} {
      allow read, write: if true;
    }

    // Monthly Daily Checker records, kept separate from the daily DIC data.
    match /stores/RR7024/dailyChecker/{monthKey} {
      allow read, write: if true;
    }

    // Non Cash monthly reconciliation (one document per month, e.g. 2026-11).
    match /stores/RR7024/nonCash/{monthId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
